+++ b/drivers/net/wireless/rockchip_wlan/rtl8189fs/Makefile
@@ -1,3 +1,7 @@
+# meta-lubancat: Yocto builds with O=${B}, so $(src) is relative to $(srctree)
+# and cannot be used directly in -I. Resolve it to an absolute path once.
+LUBANCAT_WIFI_SRC := $(if $(filter /%,$(src)),$(src),$(srctree)/$(src))
+
 ccflags-y += -O1
 #ccflags-y += -O3
 #ccflags-y += -Wall
@@ -19,7 +23,7 @@ ifeq ($(GCC_VER_49),1)
 ccflags-y += -Wno-date-time	# Fix compile error && warning on gcc 4.9 and later
 endif
 
-ccflags-y += -I$(src)/include
+ccflags-y += -I$(LUBANCAT_WIFI_SRC)/include
 
 ccflags-y += -DCONFIG_LITTLE_ENDIAN
 ccflags-y += -DCONFIG_IOCTL_CFG80211 -DRTW_USE_CFG80211_STA_EVENT
@@ -249,10 +253,10 @@ _HAL_INTFS_FILES :=	hal/hal_intf.o \
 			hal/led/hal_$(HCI_NAME)_led.o
 
 
-ccflags-y += -I$(src)/platform
+ccflags-y += -I$(LUBANCAT_WIFI_SRC)/platform
 _PLATFORM_FILES := platform/platform_ops.o
 
-ccflags-y += -I$(src)/hal/btc
+ccflags-y += -I$(LUBANCAT_WIFI_SRC)/hal/btc
 
 ########### HAL_RTL8188E #################################
 ifeq ($(CONFIG_RTL8188E), y)
diff --git a/drivers/net/wireless/rockchip_wlan/rtl8189fs/hal/phydm/phydm.mk b/drivers/net/wireless/rockchip_wlan/rtl8189fs/hal/phydm/phydm.mk
