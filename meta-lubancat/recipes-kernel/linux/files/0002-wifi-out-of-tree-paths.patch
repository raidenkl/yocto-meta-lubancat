+EXTRA_CFLAGS += -I$(LUBANCAT_WIFI_SRC)/include
 
 EXTRA_LDFLAGS += --strip-debug
 
@@ -361,10 +365,10 @@ _HAL_INTFS_FILES :=	hal/hal_intf.o \
 			hal/led/hal_$(HCI_NAME)_led.o
 
 
-EXTRA_CFLAGS += -I$(src)/platform
