# ---------------------------------------------------------------------------
# 构建工作区（kas 在仓库根创建，全部由 .gitignore 排除）
# ---------------------------------------------------------------------------
/build/
/tmp/
/downloads/
/sstate-cache/

# kas 按 kas/lubancat.yml 里的 url 把上游层 clone 到仓库根
/poky/
/meta-arm/
/meta-openembedded/
/meta-rockchip/

# 只忽略"生成出来"的 conf；不要写裸 *.conf，否则会连 build-conf/local.conf.sample 一起吃掉
/build/conf/local.conf*
/build/conf/bblayers.conf*
*.conf.bak
*.conf.orig

# ---------------------------------------------------------------------------
# 镜像与固件产物（tools/rkpack/ 下两个无扩展名 ELF 是唯一入库的二进制）
# ---------------------------------------------------------------------------
*.wic
*.wic.gz
*.wic.bz2
*.wic.xz
*.wic.bmap
*.rootfs.ext4
*.rootfs.tar.*
*.rootfs.*
boot-ext2.img
update.img
*.ext2
*.bin
*.img

# ---------------------------------------------------------------------------
# 日志与临时文件
# ---------------------------------------------------------------------------
*.log
serial-log*.txt
buildhistory/
toaster/
workspace/
*.orig
*.rej
*.patch.orig

# ---------------------------------------------------------------------------
# 编辑器 / 系统
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Python（kas venv 与本层脚本）
# ---------------------------------------------------------------------------
.kas/
__pycache__/
*.py[cod]
